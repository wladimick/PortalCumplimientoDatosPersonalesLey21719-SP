# TIBOX Compliance — ejemplo de variables
# No agregar secretos reales a este archivo.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — variables públicas requeridas por la aplicación
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — SOLO servidor.
# Se usa en operaciones administrativas destructivas que requieren limpiar usuarios Auth huérfanos.
# Nunca usar prefijo NEXT_PUBLIC_ ni exponer este valor al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Microsoft 365 / Entra ID — futuras, según decisiones P04/P05/P07
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_MODE=

# Observabilidad / email / jobs se agregarán solo al seleccionar proveedor.
