# TIBOX Compliance — ejemplo de variables
# No agregar secretos reales a este archivo.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase - públicas
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase - SOLO servidor. No usar NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Microsoft 365 / Entra ID - futuras, según decisión de integración
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_MODE=

# Observabilidad / email / jobs se agregarán solo al seleccionar proveedor.
